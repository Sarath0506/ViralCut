# API
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://viralcut:viralcut@localhost:5434/viralcut
JWT_SECRET=change-me-to-at-least-32-chars-long-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:3000
BRAND_WEB_URL=http://localhost:3000
WITHDRAWAL_FEE_BPS=150

# Redis (optional in dev — use Upstash free tier in prod)
REDIS_URL=

# Object storage (Cloudflare R2 — optional in dev)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Creator auth — WhatsApp OTP (Meta Business API, usage-based)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_OTP_TEMPLATE_NAME=

# Brand auth — email (Resend SMTP free tier: 3000/mo)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Google Cloud (optional — Stitch MCP)
GOOGLE_CLOUD_PROJECT=

# Stitch MCP
STITCH_API_KEY=
