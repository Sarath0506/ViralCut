# Copy to .env — never commit .env

NODE_ENV=development
PORT=3001

# Local + shared DB: Railway Postgres → Variables → DATABASE_PUBLIC_URL (not .internal)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway

JWT_SECRET=change-me-to-at-least-32-chars-long-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Password reset link lifetime (e.g. 1h, 30m) — must match email copy
PASSWORD_RESET_TTL=1h
# Comma-separated. Include every local brand UI origin (Next + Vite SPA).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Must match the public URL of the brand app (reset links: /reset-password?token=...)
BRAND_WEB_URL=http://localhost:5173
# Reference image/video uploads are stored on the API server disk:
# services/api/uploads/reference-assets/ (not in Postgres; DB stores JSON URLs only)
WITHDRAWAL_FEE_BPS=150

OTP_DEV_LOG=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_OTP_TEMPLATE_NAME=login_otp

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=

# apps/web-brand-spa/.env → VITE_API_URL=http://localhost:3001
# Apply DB migrations (from repo root, with DATABASE_URL set above):
#   pnpm --filter @viralcut/api prisma:migrate:deploy

# Railway prod: @viralcut/api uses ${{Postgres.DATABASE_URL}} (internal)
# Railway prod: CORS/BRAND → https://viralcutweb-brand-production.up.railway.app
# Railway prod: NEXT_PUBLIC_API_URL → https://viralcutapi-production.up.railway.app
