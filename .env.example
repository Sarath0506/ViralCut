# Copy to .env — never commit .env

NODE_ENV=development
PORT=3001

# Local + shared DB: Railway Postgres → Variables → DATABASE_PUBLIC_URL (not .internal)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway

JWT_SECRET=change-me-to-at-least-32-chars-long-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Password reset link lifetime (e.g. 1h, 30m) — must match email copy
PASSWORD_RESET_TTL=1h
# Comma-separated. Include every local brand UI origin (Next + Vite SPA).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Must match the public URL of the brand app (reset links: /reset-password?token=...)
BRAND_WEB_URL=http://localhost:5173
# Reference image/video uploads: Cloudflare R2 when S3_* vars are set, else local disk:
# services/api/uploads/ (DB stores public URLs only)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
WITHDRAWAL_FEE_BPS=150

OTP_DEV_LOG=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v22.0
# Must match an APPROVED template in Meta Business → WhatsApp → Message templates
WHATSAPP_OTP_TEMPLATE_NAME=login_otp
# Language must match the template (often en_US for auth OTP, not en)
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
# true only if the template has a URL button component
WHATSAPP_OTP_TEMPLATE_HAS_BUTTON=false

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=

# apps/web-brand-spa/.env → VITE_API_URL=http://localhost:3001
# Apply DB migrations (from repo root, with DATABASE_URL set above):
#   pnpm --filter @viralcut/api prisma:migrate:deploy

# Railway prod: @viralcut/api uses ${{Postgres.DATABASE_URL}} (internal)
# Railway prod: CORS/BRAND → https://viralcutweb-brand-production.up.railway.app
# Railway prod: CORS/AGENCY → https://viralcutweb-agency-production.up.railway.app (or your agency URL)
# Railway prod: BRAND_WEB_URL / AGENCY_WEB_URL → matching SPA deploy URLs
# Railway prod: NEXT_PUBLIC_API_URL → https://viralcutapi-production.up.railway.app
#
# Agency SPA service (@viralcut/web-agency): Root Directory = / (repo root)
# Config file = /apps/web-agency-spa/railway.toml
# Must be connected to GitHub + watch apps/web-agency-spa/** (see railway.toml)
